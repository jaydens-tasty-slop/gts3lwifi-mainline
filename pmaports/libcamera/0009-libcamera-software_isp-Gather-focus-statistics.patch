diff --git a/include/libcamera/internal/software_isp/swisp_stats.h b/include/libcamera/internal/software_isp/swisp_stats.h
index d9d0d9be..1b8879c4 100644
--- a/include/libcamera/internal/software_isp/swisp_stats.h
+++ b/include/libcamera/internal/software_isp/swisp_stats.h
@@ -17,6 +17,10 @@ namespace libcamera {
 /**
  * \brief Struct that holds the statistics for the Software ISP
  *
+ * The focus statistics divide the statistics window in a grid of regions and
+ * measure the high frequency content of the green channel in each of them, for
+ * use by contrast detection autofocus algorithms.
+ *
  * The struct value types are large enough to not overflow.
  * Should they still overflow for some reason, no check is performed and they
  * wrap around.
@@ -43,6 +47,39 @@ struct SwIspStats {
 	 * \brief A histogram of luminance values of all the sampled pixels
 	 */
 	Histogram yHistogram;
+	/**
+	 * \brief Number of columns in the focus statistics grid
+	 */
+	static constexpr unsigned int kFocusGridWidth = 8;
+	/**
+	 * \brief Number of rows in the focus statistics grid
+	 */
+	static constexpr unsigned int kFocusGridHeight = 6;
+	/**
+	 * \brief Focus statistics for one region of the grid
+	 *
+	 * The values are scaled to 8 bits per pixel regardless of the input
+	 * format bit depth.
+	 */
+	struct FocusRegion {
+		/**
+		 * \brief Sum of the squared differences between the green
+		 * values of horizontally adjacent samples
+		 */
+		uint64_t contrast;
+		/**
+		 * \brief Sum of the green values of the samples
+		 */
+		uint64_t sum;
+		/**
+		 * \brief Number of samples accumulated in the region
+		 */
+		uint32_t count;
+	};
+	/**
+	 * \brief Focus statistics of the grid regions, in raster scan order
+	 */
+	std::array<FocusRegion, kFocusGridWidth * kFocusGridHeight> focus;
 };
 
 } /* namespace libcamera */
