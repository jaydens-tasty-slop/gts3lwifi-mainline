From 6244d4f3ee4f4e1e96f1941769d3074390bb43a3 Mon Sep 17 00:00:00 2001
From: Jayden Milne <linux@jayd.ml>
Date: Fri, 30 Oct 2026 23:15:29 -0600
Subject: [PATCH] libcamera: software_isp: Pad the output frame size to whole
 line groups

Hardware consumers of the software ISP output buffers may read them in
groups of lines, past the last line of the frame. The Venus video
encoder of the Qualcomm MSM8996 reads RGBA input in groups of 32 lines,
and its kernel driver rejects dma-bufs smaller than that, so a 3840x2160
frame, whose height is not a multiple of 32, can't be imported for
encoding.

Size the output buffers for the height rounded up to a multiple of 32
lines, as V4L2 drivers do with sizeimage. The stride and the lines that
are written don't change.

Signed-off-by: Jayden Milne <linux@jayd.ml>
Assisted-by: Claude:claude-opus-5-5
---
 src/libcamera/software_isp/debayer.cpp     | 9 +++++++++
 src/libcamera/software_isp/debayer.h       | 2 ++
 src/libcamera/software_isp/debayer_cpu.cpp | 8 ++++++--
 src/libcamera/software_isp/debayer_egl.cpp | 8 ++++++--
 4 files changed, 23 insertions(+), 4 deletions(-)

diff --git a/src/libcamera/software_isp/debayer.cpp b/src/libcamera/software_isp/debayer.cpp
index d60b2a23..7ba8e55d 100644
--- a/src/libcamera/software_isp/debayer.cpp
+++ b/src/libcamera/software_isp/debayer.cpp
@@ -242,6 +242,15 @@ Debayer::~Debayer()
  * reversed.
  */
 
+/**
+ * \var Debayer::kOutputHeightAlign
+ * \brief Line alignment of the output frame size
+ *
+ * Hardware consumers of the output buffers, such as video encoders, may read
+ * the frame in groups of lines and past its last line. The output frame size
+ * covers the frame height rounded up to a multiple of this number of lines.
+ */
+
 /**
  * \var Debayer::bench_
  * \brief Benchmarking utility instance for performance measurements
diff --git a/src/libcamera/software_isp/debayer.h b/src/libcamera/software_isp/debayer.h
index 6c52ed02..dc9d800c 100644
--- a/src/libcamera/software_isp/debayer.h
+++ b/src/libcamera/software_isp/debayer.h
@@ -87,6 +87,8 @@ private:
 	virtual Size patternSize(PixelFormat inputFormat) = 0;
 
 protected:
+	static constexpr unsigned int kOutputHeightAlign = 32;
+
 	void dmaSyncBegin(std::vector<DmaSyncer> &dmaSyncers, FrameBuffer *input, FrameBuffer *output);
 	static bool isStandardBayerOrder(BayerFormat::Order order);
 };
diff --git a/src/libcamera/software_isp/debayer_cpu.cpp b/src/libcamera/software_isp/debayer_cpu.cpp
index c84832cf..47f204b1 100644
--- a/src/libcamera/software_isp/debayer_cpu.cpp
+++ b/src/libcamera/software_isp/debayer_cpu.cpp
@@ -784,10 +784,14 @@ DebayerCpu::strideAndFrameSize(const PixelFormat &outputFormat, const Size &size
 	if (getOutputConfig(outputFormat, config) != 0)
 		return std::make_tuple(0, 0);
 
-	/* round up to multiple of 8 for 64 bits alignment */
+	/*
+	 * round up to multiple of 8 for 64 bits alignment, and the frame size
+	 * to whole groups of kOutputHeightAlign lines
+	 */
 	unsigned int stride = (size.width * config.bpp / 8 + 7) & ~7;
+	unsigned int height = utils::alignUp(size.height, kOutputHeightAlign);
 
-	return std::make_tuple(stride, stride * size.height);
+	return std::make_tuple(stride, stride * height);
 }
 
 void DebayerCpuThread::setupInputMemcpy(const uint8_t *linePointers[])
diff --git a/src/libcamera/software_isp/debayer_egl.cpp b/src/libcamera/software_isp/debayer_egl.cpp
index aaa42b5b..0f99e38b 100644
--- a/src/libcamera/software_isp/debayer_egl.cpp
+++ b/src/libcamera/software_isp/debayer_egl.cpp
@@ -397,10 +397,14 @@ DebayerEGL::strideAndFrameSize(const PixelFormat &outputFormat, const Size &size
 	if (getOutputConfig(outputFormat, config) != 0)
 		return std::make_tuple(0, 0);
 
-	/* Align stride to 256 bytes as a generic GPU memory access alignment */
+	/*
+	 * Align stride to 256 bytes as a generic GPU memory access alignment,
+	 * and the frame size to whole groups of kOutputHeightAlign lines.
+	 */
 	unsigned int stride = libcamera::utils::alignUp(size.width * config.bpp / 8, 256);
+	unsigned int height = libcamera::utils::alignUp(size.height, kOutputHeightAlign);
 
-	return std::make_tuple(stride, stride * size.height);
+	return std::make_tuple(stride, stride * height);
 }
 
 uint32_t DebayerEGL::preferredInputStride(const PixelFormat &inputFormat, const Size &size)
-- 
2.56.0

