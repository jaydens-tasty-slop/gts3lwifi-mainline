# Reference: <https://postmarketos.org/devicepkg>
maintainer="psigod <psigod@example.com>"
pkgname=device-samsung-gts3lwifi
pkgdesc="Samsung Galaxy Tab S3 (Wi-Fi)"
pkgver=1
pkgrel=4
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	bluez-btmgmt
	iio-sensor-proxy
	linux-firmware-ath10k
	linux-firmware-qca
	linux-firmware-qcom
	linux-postmarketos-qcom-msm8996
	mkbootimg
	postmarketos-base
	soc-qcom-msm8996
	"
makedepends="devicepkg-dev"
subpackages="$pkgname-openrc"
source="
	deviceinfo
	modules-load.conf
	gts3-bdaddr
	gts3-bdaddr.initd
	gts3-firmware
	gts3-firmware.initd
	gts3-firmware.service
	gts3-bdaddr.service
	90-gts3-bdaddr.rules
	51-gts3lwifi-audio.conf
	ucm2-gts3lwifi.conf
	ucm2-gts3lwifi-HiFi.conf
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Bluetooth address from the efs partition (see gts3-bdaddr)
	install -Dm755 "$srcdir"/gts3-bdaddr "$pkgdir"/usr/sbin/gts3-bdaddr
	install -Dm644 "$srcdir"/gts3-bdaddr.service \
		"$pkgdir"/usr/lib/systemd/system/gts3-bdaddr.service
	install -Dm644 "$srcdir"/90-gts3-bdaddr.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-gts3-bdaddr.rules

	# Samsung-signed firmware, Wi-Fi board data and the sensor registry
	# from the tablet's own partitions (see gts3-firmware)
	install -Dm755 "$srcdir"/gts3-firmware "$pkgdir"/usr/sbin/gts3-firmware
	install -Dm644 "$srcdir"/gts3-firmware.service \
		"$pkgdir"/usr/lib/systemd/system/gts3-firmware.service
	mkdir -p "$pkgdir"/usr/lib/systemd/system/sysinit.target.wants
	ln -s ../gts3-firmware.service \
		"$pkgdir"/usr/lib/systemd/system/sysinit.target.wants/gts3-firmware.service

	# Audio: ALSA UCM profile and WirePlumber tuning (see docs/audio.md)
	install -Dm644 "$srcdir"/51-gts3lwifi-audio.conf \
		-t "$pkgdir"/usr/share/wireplumber/wireplumber.conf.d
	install -Dm644 "$srcdir"/ucm2-gts3lwifi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Samsung/gts3lwifi/gts3lwifi.conf
	install -Dm644 "$srcdir"/ucm2-gts3lwifi-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Samsung/gts3lwifi/HiFi.conf
	mkdir -p "$pkgdir"/usr/share/alsa/ucm2/conf.d/apq8096
	ln -s ../../Samsung/gts3lwifi/gts3lwifi.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/apq8096/Galaxy Tab S3.conf"
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install"
	install -Dm755 "$srcdir"/gts3-bdaddr.initd "$subpkgdir"/etc/init.d/gts3-bdaddr
	install -Dm755 "$srcdir"/gts3-firmware.initd "$subpkgdir"/etc/init.d/gts3-firmware
}

