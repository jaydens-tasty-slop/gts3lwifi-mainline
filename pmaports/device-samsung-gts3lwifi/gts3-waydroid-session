#!/bin/sh
# Android full screen: Waydroid as a login session of its own, in cage.
# `waydroid show-full-ui` runs for as long as Android does, so powering
# Android off (or `waydroid session stop`) ends the session and returns to
# the login screen. A session left over from elsewhere is stopped first, or
# show-full-ui would only open a window and return.
#
# Defaults for this tablet:
#  - density 320, as stock Android on the Tab S3 (Waydroid reads it from
#    GRID_UNIT_PX x 20; set GRID_UNIT_PX yourself to override)
#  - Android's timezone follows the host's (it otherwise stays on UTC). It is
#    an Android property that persists in its data, so it is set once after
#    Android has booted, and again only when the host timezone changes.
#    (persist.waydroid.suspend is left off: on this tablet the container came
#    back from it with its window gone and no default route.)
#    `gts3-waydroid-session --sync-props` does just that, for a Waydroid
#    session started some other way (e.g. in windows on Plasma).

state=${XDG_DATA_HOME:-$HOME/.local/share}/waydroid/gts3-props

sync_props() {
	tz=$(readlink /etc/localtime 2>/dev/null | sed -n 's|.*/zoneinfo/||p')
	want="tz=$tz"
	[ "$(cat "$state" 2>/dev/null)" = "$want" ] && return 0
	# Wait for Android to boot, checking rarely: the first boot is heavy
	i=0
	while [ "$(waydroid prop get sys.boot_completed 2>/dev/null)" != 1 ]; do
		i=$((i + 1))
		[ $i -gt 30 ] && return 1
		sleep 20
	done
	[ -n "$tz" ] && waydroid prop set persist.sys.timezone "$tz"
	mkdir -p "$(dirname "$state")" && echo "$want" > "$state"
}

if [ "$1" = --sync-props ]; then
	sync_props
	exit $?
fi

export GRID_UNIT_PX="${GRID_UNIT_PX:-16}"
waydroid session stop >/dev/null 2>&1
sync_props >/dev/null 2>&1 &
exec cage -d -s -- waydroid show-full-ui
