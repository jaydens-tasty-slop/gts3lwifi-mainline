# Accelerometer orientation for iio-sensor-proxy (and so for KDE/GNOME
# auto-rotate), SM-T825 only. The SLPI hands out accelerometer axes in a
# frame set by each model's sensor registry: on the SM-T820 the SMGR
# driver's default mount matrix gives the right orientation, on the SM-T825
# the axes come out turned by 90 degrees (confirmed in all positions on an
# SM-T825 with this matrix). The model is the first root compatible.
SUBSYSTEM=="iio", ATTR{name}=="qcom-smgr-accel", PROGRAM="/bin/grep -q samsung,gts3llte /sys/firmware/devicetree/base/compatible", ENV{ACCEL_MOUNT_MATRIX}="1, 0, 0; 0, -1, 0; 0, 0, 1"
