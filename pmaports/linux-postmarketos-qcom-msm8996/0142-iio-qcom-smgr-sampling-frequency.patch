From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jayden Milne <linux@jayd.ml>
Date: Sun, 1 Nov 2026 11:28:31 -0700
Subject: [PATCH] iio: qcom_smgr: stream at the sampling frequency userspace
 set

sampling_frequency is writable, but the value was never used: every
buffer enable picked the fastest native rate again, and a buffer disable
set the stored rate to 0, so the attribute read 0 until the next enable.
SMGR sends one QMI indication per sample, so a sensor kept streaming at
its top rate wakes the application processor that often even when the
reader only wants a few samples a second (iio-sensor-proxy reads the
accelerometer for screen rotation every 700 ms).

Keep the requested rate across buffer disables, use it at buffer enable,
reject rates outside the advertised range, and start from the same
default as before: the fastest native rate, capped at the SMGR maximum.
Whether SMGR accepts rates between the native ones is not known; a
rejected rate fails the buffer enable as other SMGR errors do.

The driver is in the msm8996-mainline tree (v6.19.5-msm8996), not in
mainline yet. Compile-tested only.

Signed-off-by: Jayden Milne <linux@jayd.ml>
Assisted-by: Claude:claude-opus-5-5
---
 drivers/iio/common/qcom_smgr/qcom_smgr.c | 49 ++++++++++++++++--------
 1 file changed, 33 insertions(+), 16 deletions(-)

diff --git a/drivers/iio/common/qcom_smgr/qcom_smgr.c b/drivers/iio/common/qcom_smgr/qcom_smgr.c
index 3f753c02a648..cce77d0117e4 100644
--- a/drivers/iio/common/qcom_smgr/qcom_smgr.c
+++ b/drivers/iio/common/qcom_smgr/qcom_smgr.c
@@ -160,6 +160,24 @@ static int qcom_smgr_request_single_sensor_info(struct qcom_smgr *smgr,
 	return 0;
 }
 
+/*
+ * The sample rate to stream at until userspace sets another: the fastest
+ * native rate of the sensor, capped at the maximum SMGR supports for it,
+ * which may be lower.
+ */
+static u16 qcom_smgr_default_sample_rate(const struct qcom_smgr_data_type_item *dt)
+{
+	u16 rate = 0;
+
+	if (dt->native_sample_rates)
+		rate = dt->native_sample_rates[dt->native_sample_rate_count - 1];
+
+	if (rate == 0 || rate > dt->max_sample_rate)
+		rate = dt->max_sample_rate;
+
+	return rate;
+}
+
 static int qcom_smgr_request_buffering(struct qcom_smgr *smgr,
 				       struct qcom_smgr_sensor *sensor,
 				       bool enable)
@@ -190,20 +208,14 @@ static int qcom_smgr_request_buffering(struct qcom_smgr *smgr,
 		 * A report cannot have 0 samples, therefore report rate cannot
 		 * be higher than sample rate.
 		 *
-		 * Fow now we default to the maximum sample rate and set the
-		 * report rate such that every report contains only 1 sample.
-		 * This gives us the lowest latency.
-		 */
-		if (dt->native_sample_rates)
-			sample_rate = dt->native_sample_rates
-					[dt->native_sample_rate_count - 1];
-
-		/*
-		 * SMGR may support a lower maximum sample rate than natively
-		 * supported by the sensor.
+		 * Stream at the sampling frequency set through sysfs (by
+		 * default the fastest one) and set the report rate such that
+		 * every report contains only 1 sample. This gives us the lowest
+		 * latency.
 		 */
+		sample_rate = dt->cur_sample_rate;
 		if (sample_rate == 0 || sample_rate > dt->max_sample_rate)
-			sample_rate = dt->max_sample_rate;
+			sample_rate = qcom_smgr_default_sample_rate(dt);
 
 		req.report_rate = sample_rate * SMGR_REPORT_RATE_HZ;
 
@@ -253,7 +265,8 @@ static int qcom_smgr_request_buffering(struct qcom_smgr *smgr,
 	}
 
 	/* Keep track of requested sample rate */
-	dt->cur_sample_rate = sample_rate;
+	if (enable)
+		dt->cur_sample_rate = sample_rate;
 
 	return 0;
 }
@@ -412,13 +425,18 @@ static int qcom_smgr_iio_write_raw(struct iio_dev *iio_dev,
 				   int val2, long mask)
 {
 	struct qcom_smgr_iio_priv *priv = iio_priv(iio_dev);
+	struct qcom_smgr_data_type_item *dt =
+		&priv->sensor->data_types[priv->sensor->data_type];
 
 	switch (mask) {
 	case IIO_CHAN_INFO_SAMP_FREQ:
+		if (val < 1 || val > dt->max_sample_rate)
+			return -EINVAL;
+
 		if (!iio_device_claim_direct(iio_dev))
 			return -EBUSY;
 
-		priv->sensor->data_types[priv->sensor->data_type].cur_sample_rate = val;
+		dt->cur_sample_rate = val;
 
 		iio_device_release_direct(iio_dev);
 		return 0;
@@ -882,9 +900,8 @@ static int qcom_smgr_probe(struct qrtr_device *qdev)
 				smgr->sensors[i].id);
 
 		for (j = 0; j < smgr->sensors[i].data_type_count; j++) {
-			/* Default to maximum sample rate */
 			smgr->sensors[i].data_types[j].cur_sample_rate =
-				smgr->sensors[i].data_types[j].max_sample_rate;
+				qcom_smgr_default_sample_rate(&smgr->sensors[i].data_types[j]);
 
 			dev_dbg(smgr->dev, "0x%02x,%d: type %u, %s %s, max %u Hz, range %u\n",
 				smgr->sensors[i].id, j,
-- 
2.56.0

