From 34d88eb54c69a29e025eff57baef7dcfe6b2bac8 Mon Sep 17 00:00:00 2001
From: psigod <psigod@example.com>
Date: Mon, 28 Sep 2026 11:57:24 +0530
Subject: [PATCH] drm/msm/mdp5: add split display support for bonded
 command-mode DSI

MDP5 never routed pixels to the slave link of a bonded DSI panel: the
slave DSI got an encoder but no connector, no mixer and no pingpong, and
a mode narrower than a single layer mixer (2048 px on msm8996) was
rendered by one mixer into the master interface only. The master DSI
host, configured for half the width, then streamed a 2048-wide line into
a 1024-wide command mode packet, which shows up on the Samsung Galaxy
Tab S3 panel as a horizontally squeezed, vertically stretched picture
with shifted colours.

Wire the slave encoder to the master at modeset init and, when the CRTC
drives a bonded DSI pair, always assign a right mixer. The right mixer
is driven through the slave's own CTL and pingpong: the slave CTL's
layer and op registers are programmed by the master path, both
pingpongs get tear check, and the SPLIT_DPL hardware keeps them in
lockstep (single flush on the master CTL's FLUSH register, slave INTF
triggered by the master's START through the SW trigger mux). The 3D mux
packing that a right mixer normally implies is only used when both
mixers feed one interface.

A module parameter (split_start_both) lets the START signal be written
on both CTLs for bring-up experiments.

Signed-off-by: psigod <psigod@example.com>
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../gpu/drm/msm/disp/mdp5/mdp5_cmd_encoder.c  | 83 +++++++++++++------
 drivers/gpu/drm/msm/disp/mdp5/mdp5_crtc.c     |  4 +
 drivers/gpu/drm/msm/disp/mdp5/mdp5_ctl.c      | 83 +++++++++++++++++--
 drivers/gpu/drm/msm/disp/mdp5/mdp5_encoder.c  | 18 ++++
 drivers/gpu/drm/msm/disp/mdp5/mdp5_kms.c      | 20 ++++-
 drivers/gpu/drm/msm/disp/mdp5/mdp5_kms.h      | 16 ++++
 6 files changed, 194 insertions(+), 30 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/mdp5/mdp5_cmd_encoder.c b/drivers/gpu/drm/msm/disp/mdp5/mdp5_cmd_encoder.c
index e5662412d..e795c514c 100644
--- a/drivers/gpu/drm/msm/disp/mdp5/mdp5_cmd_encoder.c
+++ b/drivers/gpu/drm/msm/disp/mdp5/mdp5_cmd_encoder.c
@@ -17,6 +17,23 @@ static struct mdp5_kms *get_kms(struct drm_encoder *encoder)
 }
 
 #define VSYNC_CLK_RATE 19200000
+
+/*
+ * A command mode encoder drives one ping-pong block, or two when the CRTC
+ * is a split display (bonded DSI: one mixer/ping-pong/INTF per link).
+ */
+static int encoder_pp_ids(struct drm_encoder *encoder, int pp_id[2])
+{
+	struct mdp5_pipeline *pipeline = mdp5_crtc_get_pipeline(encoder->crtc);
+	int n = 0;
+
+	pp_id[n++] = pipeline->mixer->pp;
+	if (pipeline->r_intf && pipeline->r_mixer)
+		pp_id[n++] = pipeline->r_mixer->pp;
+
+	return n;
+}
+
 static int pingpong_tearcheck_setup(struct drm_encoder *encoder,
 				    struct drm_display_mode *mode)
 {
@@ -24,8 +41,9 @@ static int pingpong_tearcheck_setup(struct drm_encoder *encoder,
 	struct device *dev = encoder->dev->dev;
 	u32 total_lines, vclks_line, cfg;
 	long vsync_clk_speed;
-	struct mdp5_hw_mixer *mixer = mdp5_crtc_get_mixer(encoder->crtc);
-	int pp_id = mixer->pp;
+	int pp_ids[2], pp_id, n, i;
+
+	n = encoder_pp_ids(encoder, pp_ids);
 
 	if (IS_ERR_OR_NULL(mdp5_kms->vsync_clk)) {
 		DRM_DEV_ERROR(dev, "vsync_clk is not initialized\n");
@@ -58,18 +76,22 @@ static int pingpong_tearcheck_setup(struct drm_encoder *encoder,
 	 * panel arrive too late or not at all, but is currently used by default
 	 * because these panel interrupts are not wired up yet.
 	 */
-	mdp5_write(mdp5_kms, REG_MDP5_PP_SYNC_CONFIG_VSYNC(pp_id), cfg);
-	mdp5_write(mdp5_kms,
-		REG_MDP5_PP_SYNC_CONFIG_HEIGHT(pp_id), (2 * mode->vtotal));
-
-	mdp5_write(mdp5_kms,
-		REG_MDP5_PP_VSYNC_INIT_VAL(pp_id), mode->vdisplay);
-	mdp5_write(mdp5_kms, REG_MDP5_PP_RD_PTR_IRQ(pp_id), mode->vdisplay + 1);
-	mdp5_write(mdp5_kms, REG_MDP5_PP_START_POS(pp_id), mode->vdisplay);
-	mdp5_write(mdp5_kms, REG_MDP5_PP_SYNC_THRESH(pp_id),
-			MDP5_PP_SYNC_THRESH_START(4) |
-			MDP5_PP_SYNC_THRESH_CONTINUE(4));
-	mdp5_write(mdp5_kms, REG_MDP5_PP_AUTOREFRESH_CONFIG(pp_id), 0x0);
+	for (i = 0; i < n; i++) {
+		pp_id = pp_ids[i];
+
+		mdp5_write(mdp5_kms, REG_MDP5_PP_SYNC_CONFIG_VSYNC(pp_id), cfg);
+		mdp5_write(mdp5_kms,
+			REG_MDP5_PP_SYNC_CONFIG_HEIGHT(pp_id), (2 * mode->vtotal));
+
+		mdp5_write(mdp5_kms,
+			REG_MDP5_PP_VSYNC_INIT_VAL(pp_id), mode->vdisplay);
+		mdp5_write(mdp5_kms, REG_MDP5_PP_RD_PTR_IRQ(pp_id), mode->vdisplay + 1);
+		mdp5_write(mdp5_kms, REG_MDP5_PP_START_POS(pp_id), mode->vdisplay);
+		mdp5_write(mdp5_kms, REG_MDP5_PP_SYNC_THRESH(pp_id),
+				MDP5_PP_SYNC_THRESH_START(4) |
+				MDP5_PP_SYNC_THRESH_CONTINUE(4));
+		mdp5_write(mdp5_kms, REG_MDP5_PP_AUTOREFRESH_CONFIG(pp_id), 0x0);
+	}
 
 	return 0;
 }
@@ -77,10 +99,11 @@ static int pingpong_tearcheck_setup(struct drm_encoder *encoder,
 static int pingpong_tearcheck_enable(struct drm_encoder *encoder)
 {
 	struct mdp5_kms *mdp5_kms = get_kms(encoder);
-	struct mdp5_hw_mixer *mixer = mdp5_crtc_get_mixer(encoder->crtc);
-	int pp_id = mixer->pp;
+	int pp_ids[2], n, i;
 	int ret;
 
+	n = encoder_pp_ids(encoder, pp_ids);
+
 	ret = clk_set_rate(mdp5_kms->vsync_clk,
 		clk_round_rate(mdp5_kms->vsync_clk, VSYNC_CLK_RATE));
 	if (ret) {
@@ -95,7 +118,8 @@ static int pingpong_tearcheck_enable(struct drm_encoder *encoder)
 		return ret;
 	}
 
-	mdp5_write(mdp5_kms, REG_MDP5_PP_TEAR_CHECK_EN(pp_id), 1);
+	for (i = 0; i < n; i++)
+		mdp5_write(mdp5_kms, REG_MDP5_PP_TEAR_CHECK_EN(pp_ids[i]), 1);
 
 	return 0;
 }
@@ -103,13 +127,26 @@ static int pingpong_tearcheck_enable(struct drm_encoder *encoder)
 static void pingpong_tearcheck_disable(struct drm_encoder *encoder)
 {
 	struct mdp5_kms *mdp5_kms = get_kms(encoder);
-	struct mdp5_hw_mixer *mixer = mdp5_crtc_get_mixer(encoder->crtc);
-	int pp_id = mixer->pp;
+	int pp_ids[2], n, i;
 
-	mdp5_write(mdp5_kms, REG_MDP5_PP_TEAR_CHECK_EN(pp_id), 0);
+	n = encoder_pp_ids(encoder, pp_ids);
+
+	for (i = 0; i < n; i++)
+		mdp5_write(mdp5_kms, REG_MDP5_PP_TEAR_CHECK_EN(pp_ids[i]), 0);
 	clk_disable_unprepare(mdp5_kms->vsync_clk);
 }
 
+/* flush bits of the encoder's INTF, plus the slave INTF of a split display */
+static u32 cmd_encoder_flush_mask(struct mdp5_pipeline *pipeline)
+{
+	u32 mask = mdp_ctl_flush_mask_encoder(pipeline->intf);
+
+	if (pipeline->r_intf)
+		mask |= mdp_ctl_flush_mask_encoder(pipeline->r_intf);
+
+	return mask;
+}
+
 void mdp5_cmd_encoder_mode_set(struct drm_encoder *encoder,
 			       struct drm_display_mode *mode,
 			       struct drm_display_mode *adjusted_mode)
@@ -125,7 +162,6 @@ void mdp5_cmd_encoder_disable(struct drm_encoder *encoder)
 {
 	struct mdp5_encoder *mdp5_cmd_enc = to_mdp5_encoder(encoder);
 	struct mdp5_ctl *ctl = mdp5_cmd_enc->ctl;
-	struct mdp5_interface *intf = mdp5_cmd_enc->intf;
 	struct mdp5_pipeline *pipeline = mdp5_crtc_get_pipeline(encoder->crtc);
 
 	if (WARN_ON(!mdp5_cmd_enc->enabled))
@@ -134,7 +170,7 @@ void mdp5_cmd_encoder_disable(struct drm_encoder *encoder)
 	pingpong_tearcheck_disable(encoder);
 
 	mdp5_ctl_set_encoder_state(ctl, pipeline, false);
-	mdp5_ctl_commit(ctl, pipeline, mdp_ctl_flush_mask_encoder(intf), true);
+	mdp5_ctl_commit(ctl, pipeline, cmd_encoder_flush_mask(pipeline), true);
 
 	mdp5_cmd_enc->enabled = false;
 }
@@ -143,7 +179,6 @@ void mdp5_cmd_encoder_enable(struct drm_encoder *encoder)
 {
 	struct mdp5_encoder *mdp5_cmd_enc = to_mdp5_encoder(encoder);
 	struct mdp5_ctl *ctl = mdp5_cmd_enc->ctl;
-	struct mdp5_interface *intf = mdp5_cmd_enc->intf;
 	struct mdp5_pipeline *pipeline = mdp5_crtc_get_pipeline(encoder->crtc);
 
 	if (WARN_ON(mdp5_cmd_enc->enabled))
@@ -152,7 +187,7 @@ void mdp5_cmd_encoder_enable(struct drm_encoder *encoder)
 	if (pingpong_tearcheck_enable(encoder))
 		return;
 
-	mdp5_ctl_commit(ctl, pipeline, mdp_ctl_flush_mask_encoder(intf), true);
+	mdp5_ctl_commit(ctl, pipeline, cmd_encoder_flush_mask(pipeline), true);
 
 	mdp5_ctl_set_encoder_state(ctl, pipeline, true);
 
diff --git a/drivers/gpu/drm/msm/disp/mdp5/mdp5_crtc.c b/drivers/gpu/drm/msm/disp/mdp5/mdp5_crtc.c
index 373ae7d9b..689d413a0 100644
--- a/drivers/gpu/drm/msm/disp/mdp5/mdp5_crtc.c
+++ b/drivers/gpu/drm/msm/disp/mdp5/mdp5_crtc.c
@@ -749,6 +749,10 @@ static int mdp5_crtc_atomic_check(struct drm_crtc *crtc,
 	if (mode->hdisplay > hw_cfg->lm.max_width)
 		need_right_mixer = true;
 
+	/* split display: one mixer per DSI link */
+	if (mdp5_cstate->pipeline.r_intf)
+		need_right_mixer = true;
+
 	ret = mdp5_crtc_setup_pipeline(crtc, crtc_state, need_right_mixer);
 	if (ret) {
 		DRM_DEV_ERROR(dev->dev, "couldn't assign mixers %d\n", ret);
diff --git a/drivers/gpu/drm/msm/disp/mdp5/mdp5_ctl.c b/drivers/gpu/drm/msm/disp/mdp5/mdp5_ctl.c
index fc183fe37..13c661de8 100644
--- a/drivers/gpu/drm/msm/disp/mdp5/mdp5_ctl.c
+++ b/drivers/gpu/drm/msm/disp/mdp5/mdp5_ctl.c
@@ -3,6 +3,7 @@
  * Copyright (c) 2014-2015 The Linux Foundation. All rights reserved.
  */
 
+#include <linux/module.h>
 #include <linux/string_choices.h>
 #include "mdp5_kms.h"
 #include "mdp5_ctl.h"
@@ -157,7 +158,8 @@ static void set_ctl_op(struct mdp5_ctl *ctl, struct mdp5_pipeline *pipeline)
 		break;
 	}
 
-	if (pipeline->r_mixer)
+	/* two mixers into one interface: 3D mux. Not for split display. */
+	if (pipeline->r_mixer && !pipeline->r_intf)
 		ctl_op |= MDP5_CTL_OP_PACK_3D_ENABLE |
 			  MDP5_CTL_OP_PACK_3D(1);
 
@@ -166,6 +168,57 @@ static void set_ctl_op(struct mdp5_ctl *ctl, struct mdp5_pipeline *pipeline)
 	spin_unlock_irqrestore(&ctl->hw_lock, flags);
 }
 
+/*
+ * Split display: the right mixer drives the second (slave) DSI interface
+ * through its own CTL. The slave CTL is programmed here but never flushed
+ * or started directly: with SPLIT_DPL single flush enabled, a write to the
+ * master CTL's FLUSH register flushes both CTLs, and the trigger mux routes
+ * the master's START signal to the slave interface.
+ */
+static void set_ctl_op_split(struct mdp5_ctl *ctl, struct mdp5_pipeline *pipeline)
+{
+	struct mdp5_kms *mdp5_kms = get_kms(ctl->ctlm);
+	struct mdp5_ctl *r_ctl = pipeline->r_ctl;
+	struct mdp5_interface *r_intf = pipeline->r_intf;
+	unsigned long flags;
+	u32 ctl_op, upper;
+
+	set_display_intf(mdp5_kms, r_intf);
+
+	ctl_op = MDP5_CTL_OP_INTF_NUM(INTF0 + r_intf->num);
+	if (r_intf->mode == MDP5_INTF_DSI_MODE_COMMAND)
+		ctl_op |= MDP5_CTL_OP_CMD_MODE;
+
+	spin_lock_irqsave(&r_ctl->hw_lock, flags);
+	ctl_write(r_ctl, REG_MDP5_CTL_OP(r_ctl->id), ctl_op);
+	spin_unlock_irqrestore(&r_ctl->hw_lock, flags);
+
+	if (r_intf->mode == MDP5_INTF_DSI_MODE_COMMAND) {
+		/* smart panel: slave INTF uses the master's SW trigger */
+		upper = MDP5_SPLIT_DPL_UPPER_SMART_PANEL;
+		if (pipeline->intf->num == 1)
+			upper |= MDP5_SPLIT_DPL_UPPER_INTF2_SW_TRG_MUX;
+		else
+			upper |= MDP5_SPLIT_DPL_UPPER_INTF1_SW_TRG_MUX;
+		mdp5_write(mdp5_kms, REG_MDP5_SPLIT_DPL_UPPER, upper);
+		mdp5_write(mdp5_kms, REG_MDP5_SPLIT_DPL_LOWER,
+			   MDP5_SPLIT_DPL_LOWER_SMART_PANEL);
+	} else {
+		/* dumb panel: slave timing generator synced to the master */
+		mdp5_write(mdp5_kms, REG_MDP5_SPLIT_DPL_UPPER, 0);
+		mdp5_write(mdp5_kms, REG_MDP5_SPLIT_DPL_LOWER,
+			   pipeline->intf->num == 1 ?
+			   MDP5_SPLIT_DPL_LOWER_INTF2_TG_SYNC :
+			   MDP5_SPLIT_DPL_LOWER_INTF1_TG_SYNC);
+	}
+	mdp5_write(mdp5_kms, REG_MDP5_SPLIT_DPL_EN, 1);
+	mdp5_write(mdp5_kms, REG_MDP5_SPARE_0,
+		   MDP5_SPARE_0_SPLIT_DPL_SINGLE_FLUSH_EN);
+
+	DBG("split display: CTL %d/INTF %d + CTL %d/INTF %d",
+	    ctl->id, pipeline->intf->num, r_ctl->id, r_intf->num);
+}
+
 int mdp5_ctl_set_pipeline(struct mdp5_ctl *ctl, struct mdp5_pipeline *pipeline)
 {
 	struct mdp5_kms *mdp5_kms = get_kms(ctl->ctlm);
@@ -177,6 +230,9 @@ int mdp5_ctl_set_pipeline(struct mdp5_ctl *ctl, struct mdp5_pipeline *pipeline)
 
 	set_ctl_op(ctl, pipeline);
 
+	if (pipeline->r_ctl)
+		set_ctl_op_split(ctl, pipeline);
+
 	return 0;
 }
 
@@ -205,6 +261,11 @@ static bool start_signal_needed(struct mdp5_ctl *ctl,
  * executed in order to kick off operation and activate all layers.
  * e.g.: DSI command mode, Writeback
  */
+static bool split_start_both;
+module_param(split_start_both, bool, 0644);
+MODULE_PARM_DESC(split_start_both,
+		 "Split display: also write START on the slave CTL (default: rely on the trigger mux)");
+
 static void send_start_signal(struct mdp5_ctl *ctl)
 {
 	unsigned long flags;
@@ -214,6 +275,14 @@ static void send_start_signal(struct mdp5_ctl *ctl)
 	spin_unlock_irqrestore(&ctl->hw_lock, flags);
 }
 
+static void send_start_signal_split(struct mdp5_ctl *ctl,
+				    struct mdp5_pipeline *pipeline)
+{
+	send_start_signal(ctl);
+	if (split_start_both && pipeline->r_ctl)
+		send_start_signal(pipeline->r_ctl);
+}
+
 /**
  * mdp5_ctl_set_encoder_state() - set the encoder state
  *
@@ -237,7 +306,7 @@ int mdp5_ctl_set_encoder_state(struct mdp5_ctl *ctl,
 	DBG("intf_%d: %s", intf->num, str_on_off(enabled));
 
 	if (start_signal_needed(ctl, pipeline)) {
-		send_start_signal(ctl);
+		send_start_signal_split(ctl, pipeline);
 	}
 
 	return 0;
@@ -354,12 +423,16 @@ int mdp5_ctl_blend(struct mdp5_ctl *ctl, struct mdp5_pipeline *pipeline,
 {
 	struct mdp5_hw_mixer *mixer = pipeline->mixer;
 	struct mdp5_hw_mixer *r_mixer = pipeline->r_mixer;
+	/* split display: the right mixer belongs to the slave CTL */
+	struct mdp5_ctl *r_ctl = pipeline->r_ctl ? pipeline->r_ctl : ctl;
 	unsigned long flags;
 	u32 blend_cfg = 0, blend_ext_cfg = 0;
 	u32 r_blend_cfg = 0, r_blend_ext_cfg = 0;
 	int i, start_stage;
 
 	mdp5_ctl_reset_blend_regs(ctl);
+	if (r_ctl != ctl)
+		mdp5_ctl_reset_blend_regs(r_ctl);
 
 	if (ctl_blend_op_flags & MDP5_CTL_BLEND_OP_FLAG_BORDER_OUT) {
 		start_stage = STAGE0;
@@ -395,9 +468,9 @@ int mdp5_ctl_blend(struct mdp5_ctl *ctl, struct mdp5_pipeline *pipeline,
 	ctl_write(ctl, REG_MDP5_CTL_LAYER_EXT_REG(ctl->id, mixer->lm),
 		  blend_ext_cfg);
 	if (r_mixer) {
-		ctl_write(ctl, REG_MDP5_CTL_LAYER_REG(ctl->id, r_mixer->lm),
+		ctl_write(r_ctl, REG_MDP5_CTL_LAYER_REG(r_ctl->id, r_mixer->lm),
 			  r_blend_cfg);
-		ctl_write(ctl, REG_MDP5_CTL_LAYER_EXT_REG(ctl->id, r_mixer->lm),
+		ctl_write(r_ctl, REG_MDP5_CTL_LAYER_EXT_REG(r_ctl->id, r_mixer->lm),
 			  r_blend_ext_cfg);
 	}
 	spin_unlock_irqrestore(&ctl->hw_lock, flags);
@@ -572,7 +645,7 @@ u32 mdp5_ctl_commit(struct mdp5_ctl *ctl,
 	}
 
 	if (start_signal_needed(ctl, pipeline)) {
-		send_start_signal(ctl);
+		send_start_signal_split(ctl, pipeline);
 	}
 
 	return curr_ctl_flush_mask;
diff --git a/drivers/gpu/drm/msm/disp/mdp5/mdp5_encoder.c b/drivers/gpu/drm/msm/disp/mdp5/mdp5_encoder.c
index eaba3b2d7..d9d87a8bc 100644
--- a/drivers/gpu/drm/msm/disp/mdp5/mdp5_encoder.c
+++ b/drivers/gpu/drm/msm/disp/mdp5/mdp5_encoder.c
@@ -224,6 +224,13 @@ static int mdp5_encoder_atomic_check(struct drm_encoder *encoder,
 
 	mdp5_cstate->ctl = ctl;
 	mdp5_cstate->pipeline.intf = intf;
+	if (mdp5_encoder->slave) {
+		mdp5_cstate->pipeline.r_intf = mdp5_encoder->slave->intf;
+		mdp5_cstate->pipeline.r_ctl = mdp5_encoder->slave->ctl;
+	} else {
+		mdp5_cstate->pipeline.r_intf = NULL;
+		mdp5_cstate->pipeline.r_ctl = NULL;
+	}
 
 	/*
 	 * This is a bit awkward, but we want to flush the CTL and hit the
@@ -280,6 +287,17 @@ void mdp5_encoder_set_intf_mode(struct drm_encoder *encoder, bool cmd_mode)
 	}
 }
 
+void mdp5_encoder_set_slave(struct drm_encoder *encoder,
+			    struct drm_encoder *slave_encoder)
+{
+	struct mdp5_encoder *mdp5_encoder = to_mdp5_encoder(encoder);
+	struct mdp5_encoder *mdp5_slave = to_mdp5_encoder(slave_encoder);
+
+	mdp5_encoder->slave = mdp5_slave;
+	/* the slave INTF runs in the same mode as the master */
+	mdp5_slave->intf->mode = mdp5_encoder->intf->mode;
+}
+
 /* initialize encoder */
 struct drm_encoder *mdp5_encoder_init(struct drm_device *dev,
 				      struct mdp5_interface *intf,
diff --git a/drivers/gpu/drm/msm/disp/mdp5/mdp5_kms.c b/drivers/gpu/drm/msm/disp/mdp5/mdp5_kms.c
index 61edf6864..ea8301e46 100644
--- a/drivers/gpu/drm/msm/disp/mdp5/mdp5_kms.c
+++ b/drivers/gpu/drm/msm/disp/mdp5/mdp5_kms.c
@@ -358,9 +358,11 @@ static int modeset_init_intf(struct mdp5_kms *mdp5_kms,
 		}
 
 		ret = msm_dsi_modeset_init(priv->kms->dsi[dsi_id], dev, encoder);
-		if (!ret)
+		if (!ret) {
 			mdp5_encoder_set_intf_mode(encoder,
 						   msm_dsi_is_cmd_mode(priv->kms->dsi[dsi_id]));
+			mdp5_kms->dsi_encoders[dsi_id] = encoder;
+		}
 
 		break;
 	}
@@ -376,6 +378,7 @@ static int modeset_init_intf(struct mdp5_kms *mdp5_kms,
 static int modeset_init(struct mdp5_kms *mdp5_kms)
 {
 	struct drm_device *dev = mdp5_kms->dev;
+	struct msm_drm_private *priv = dev->dev_private;
 	unsigned int num_crtcs;
 	int i, ret, pi = 0, ci = 0;
 	struct drm_plane *primary[MAX_BASES] = { NULL };
@@ -393,6 +396,21 @@ static int modeset_init(struct mdp5_kms *mdp5_kms)
 			goto fail;
 	}
 
+	/*
+	 * Bonded DSI: the slave link has no connector of its own. Hand its
+	 * encoder (INTF + CTL) to the master so that the master drives both
+	 * halves of the panel as one split display.
+	 */
+	if (mdp5_kms->dsi_encoders[0] && mdp5_kms->dsi_encoders[1] &&
+	    msm_dsi_is_bonded_dsi(priv->kms->dsi[0])) {
+		int master = msm_dsi_is_master_dsi(priv->kms->dsi[0]) ? 0 : 1;
+
+		mdp5_encoder_set_slave(mdp5_kms->dsi_encoders[master],
+				       mdp5_kms->dsi_encoders[!master]);
+		DRM_DEV_INFO(dev->dev, "bonded DSI: split display, master DSI%d\n",
+			     master);
+	}
+
 	num_encoders = 0;
 	drm_for_each_encoder(encoder, dev)
