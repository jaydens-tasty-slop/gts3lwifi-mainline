#include "test-display.dts"
#include <dt-bindings/interrupt-controller/irq.h>

/* Test: Synaptics S5807 (RMI4) touchscreen on BLSP2 I2C3, on top of the display test. */

/* vreg_l18a_3p3 (touch analog supply, downstream tsp_avdd) is in the main DTS. */

&blsp2_i2c3 {
	status = "okay";

	touchscreen@20 {
		compatible = "syna,rmi4-i2c";
		reg = <0x20>;
		#address-cells = <1>;
		#size-cells = <0>;

		interrupt-parent = <&tlmm>;
		interrupts = <123 IRQ_TYPE_LEVEL_LOW>;

		vdd-supply = <&vreg_l18a_3p3>;
		vio-supply = <&vreg_l14a_1p8>;

		pinctrl-names = "default";
		pinctrl-0 = <&ts_int_default>;

		syna,startup-delay-ms = <100>;

		rmi4-f01@1 {
			reg = <0x1>;
			syna,nosleep-mode = <1>;
		};

		rmi4-f12@12 {
			reg = <0x12>;
			syna,sensor-type = <1>;
		};
	};
};

&tlmm {
	/* downstream tsp_int_active: gpio123 */
	ts_int_default: ts-int-default-state {
		pins = "gpio123";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};
