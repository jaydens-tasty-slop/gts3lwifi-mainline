// SPDX-License-Identifier: BSD-3-Clause
/*
 * Charger test: SM5705 charger / MUIC.
 * Stock (msm8996-sm5705.dtsi) bit-bangs an I2C bus on TLMM 33 (SDA) /
 * 32 (SCL), which are HDMI DDC pins, not a BLSP pair:
 *   0x25 SM5705 MUIC, interrupt PM8994 GPIO 4
 *   0x49 SM5705 charger + flash LED, interrupt TLMM 38 (pull-up)
 * Charging enable is PM8994 GPIO 13, active low; the bootloader leaves it
 * low.
 *
 * Without a driver the charger keeps the settings it boots with: BATREG 0x27
 * (4.38 V) and top-off 200 mA. Stock sets 4.30 V and 300 mA at boot; the
 * driver takes both from the battery node.
 */

#include "test-battery.dts"

/ {
	i2c-sm5705 {
		compatible = "i2c-gpio";
		sda-gpios = <&tlmm 33 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&tlmm 32 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <2>;
		pinctrl-names = "default";
		pinctrl-0 = <&sm5705_i2c_default>;
		#address-cells = <1>;
		#size-cells = <0>;

		charger: charger@49 {
			compatible = "siliconmitus,sm5705-charger";
			reg = <0x49>;
			interrupts-extended = <&tlmm 38 IRQ_TYPE_LEVEL_LOW>;
			pinctrl-names = "default";
			pinctrl-0 = <&charger_int_default>;
			monitored-battery = <&battery>;
		};
	};
};

&battery {
	charge-term-current-microamp = <300000>;
};

&blsp2_i2c2 {
	fuel-gauge@71 {
		power-supplies = <&charger>;
	};
};

&tlmm {
	sm5705_i2c_default: sm5705-i2c-default-state {
		pins = "gpio32", "gpio33";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	charger_int_default: charger-int-default-state {
		pins = "gpio38";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};
};
